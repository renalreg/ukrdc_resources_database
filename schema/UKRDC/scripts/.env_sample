# Database
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Source release
RELEASE_URL=https://github.com/renalreg/registry-codes/releases/latest/download/registry_codes.dump

# Files
TMP_DUMP=/tmp/registry_codes.dump
TMP_SQL=/tmp/registry_codes.data.sql
